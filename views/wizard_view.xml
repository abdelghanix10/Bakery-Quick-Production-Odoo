<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bakery_production_wizard_form" model="ir.ui.view">
        <field name="name">bakery.production.wizard.form</field>
        <field name="model">bakery.production.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Production">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_open': True}"/>
                            <field name="qty_producing"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ingredients Required">
                            <field name="ingredient_ids">
                                <list create="0" delete="0" edit="0">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_to_close" string="Confirm Production" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_bakery_production_edit_wizard_form" model="ir.ui.view">
        <field name="name">bakery.production.edit.wizard.form</field>
        <field name="model">bakery.production.edit.wizard</field>
        <field name="arch" type="xml">
            <form string="Edit Production Quantity">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="current_qty"/>
                        <field name="new_qty" autofocus="autofocus"/>
                    </group>
                    <notebook>
                        <page string="Ingredients Change">
                            <field name="line_ids">
                                <list create="0" delete="0" edit="0">
                                    <field name="product_id"/>
                                    <field name="qty_per_unit" column_invisible="1"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
